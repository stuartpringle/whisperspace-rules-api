{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["learnedByFocus", "skillId"],
  "properties": {
    "learnedByFocus": {"type": "object"},
    "skillId": {"type": "string"},
    "ranks": {"type": "object", "additionalProperties": {"type": "integer"}},
    "learningFocus": {"type": "string"},
    "skillMods": {"type": "object", "additionalProperties": {"type": "integer"}},
    "gameplayEffects": {"type": "array", "items": {"type": "string"}},
    "weapons": {"type": "array", "items": {"type": "object"}},
    "armour": {
      "oneOf": [
        {"type": "object"},
        {"type": "array", "items": {"type": "object"}}
      ]
    },
    "items": {"type": "array", "items": {"type": "object"}},
    "feats": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
