{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sheet", "learnedByFocus", "inherentSkills"],
  "properties": {
    "sheet": {"type": "object"},
    "learnedByFocus": {"type": "object"},
    "inherentSkills": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
    "maxRankInherent": {"type": "integer"},
    "maxRankOnFocus": {"type": "integer"},
    "maxRankOffFocus": {"type": "integer"},
    "gameplayEffects": {"type": "array", "items": {"type": "string"}},
    "weapons": {"type": "array", "items": {"type": "object"}},
    "armour": {
      "oneOf": [
        {"type": "object"},
        {"type": "array", "items": {"type": "object"}}
      ]
    },
    "items": {"type": "array", "items": {"type": "object"}},
    "feats": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
